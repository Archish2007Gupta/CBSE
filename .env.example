# Python backend environment variables
# Copy this file to .env and fill in the values.

# Frontend URL for CORS configuration in production (e.g. https://your-domain.gov.in)
# Leave empty for local development defaults
FRONTEND_URL=

# Groq – AI layer (obtain key at https://console.groq.com/keys)
GROQ_API_KEY=

# Optional Groq overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TEMPERATURE=0

# Ollama – embeddings only (used by the RAG retrieval pipeline)
# Ollama is not used for chat or answer generation.
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama – embedding model (used by the RAG pipeline)
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Supabase – required for pgvector storage (apply 001_pgvector_circulars.sql first)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# pgvector table / function overrides (defaults shown)
# VECTOR_TABLE=circular_embeddings
# VECTOR_QUERY_FN=match_circular_embeddings
